# Desempenho: compressão e cache no Apache.
# Tudo protegido por IfModule: se o módulo não existir no servidor, a regra é ignorada sem erro.

# compressão de texto (HTML, CSS, JS, SVG, JSON)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/xml
</IfModule>

# Canonical URLs and compatibility with old language links.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.vsexperience\.com\.br$ [NC]
  RewriteRule ^ https://vsexperience.com.br%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^vsexperience\.com\.br$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://vsexperience.com.br%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$) [NC]
  RewriteRule ^(?:index\.html)?$ /en/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=pt(&|$) [NC]
  RewriteRule ^en/(?:index\.html)?$ / [R=301,L,QSD]

  # THE_REQUEST prevents a loop when Apache serves DirectoryIndex internally.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
</IfModule>

# Do not index proposals or internal utilities. Allow robots to read this header.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, follow" "expr=%{REQUEST_URI} =~ m#^/(proposta-[^/]+|Praado|qr-generator|remove-paragraph)(/|$)|^/case-mockup-test\.html$#"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# cache
<IfModule mod_headers.c>
  # HTML, CSS e JS: o navegador guarda, mas confere a cada visita (resposta 304 barata);
  # os nomes não mudam a cada deploy, então nada de cache longo aqui
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # fontes: nunca mudam com o mesmo nome
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # imagens: um mês
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
